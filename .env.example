# Wallet Connect project ID for the /mint and /admin/mint pages' wallet
# connection flow. Get a free one at https://cloud.walletconnect.com
# Without it, browser wallets (MetaMask, Coinbase Wallet, etc.) still work —
# only the WalletConnect QR-code flow for mobile wallets needs a real ID.
VITE_WALLETCONNECT_PROJECT_ID=

# Address of the deployed W3BBFranchiseBundle contract on Polygon (see
# /contracts/README.md for how to deploy it). Leave blank until deployed —
# /admin/mint shows a "not configured yet" notice without it.
VITE_FRANCHISE_BUNDLE_CONTRACT_ADDRESS=
