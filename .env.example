# Wallet Connect project ID for the /mint and /admin/mint pages' wallet
# connection flow. Get a free one at https://cloud.walletconnect.com
# Without it, browser wallets (MetaMask, Coinbase Wallet, etc.) still work —
# only the WalletConnect QR-code flow for mobile wallets needs a real ID.
VITE_WALLETCONNECT_PROJECT_ID=

# Address of the deployed W3BBFranchiseBundle contract on Polygon (see
# /contracts/README.md for how to deploy it). Leave blank until deployed —
# /admin/mint shows a "not configured yet" notice without it.
VITE_FRANCHISE_BUNDLE_CONTRACT_ADDRESS=

# Founder Launch Platform. Leave both blank to run in demo mode. Progress
# then stays in the browser. These are separate from the lead-capture client
# in src/lib/db.ts. Point them at a Supabase project after running
# supabase/migrations/20261116000000_founder_platform.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI keys are server-side only. Do not add a VITE_ prefix.
# Set them on the Cloudflare Pages function (functions/api/founder-ai.ts)
# or the Supabase Edge Function (supabase/functions/founder-ai):
#   AI_API_KEY=          (or OPENAI_API_KEY)
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
# Without a server key, matching, blueprints, and the coach use the on-device rules.
# Remote Viewer uses the same Supabase project. Run
# supabase/migrations/20261119000000_remote_viewing.sql
# so a private memorial link opens on another device. Without it, a memorial stays in this browser.

# Analytics. Leave both blank and the site does not load a tracker.
# VITE_CF_ANALYTICS_TOKEN is the Cloudflare Web Analytics beacon token
# (page views). VITE_PLAUSIBLE_DOMAIN is the domain configured in Plausible;
# named events from track() (cta_click, form_submit) are sent there.
VITE_CF_ANALYTICS_TOKEN=
VITE_PLAUSIBLE_DOMAIN=
