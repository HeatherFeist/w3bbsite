# Wallet Connect project ID for the /mint page's wallet connection flow.
# Get a free one at https://cloud.walletconnect.com
# Without it, browser wallets (MetaMask, Coinbase Wallet, etc.) still work —
# only the WalletConnect QR-code flow for mobile wallets needs a real ID.
VITE_WALLETCONNECT_PROJECT_ID=

# Franchise Bundle NFT contract (see contracts/README.md to deploy).
# Leave both blank to keep showing the mint waitlist form. Once deployed,
# set these two and /mint switches to the live minting flow automatically.
VITE_NFT_CONTRACT_ADDRESS=
# Chain ID the contract above is deployed on: 11155111 (Sepolia testnet,
# default), 137 (Polygon), 8453 (Base), or 1 (Ethereum mainnet).
VITE_NFT_CHAIN_ID=11155111

# --- Contract deployment (contracts/, scripts/deploy.cjs — not used by the
# website itself, only by `npx hardhat run scripts/deploy.cjs`). Never commit
# real values for these. ---
# Wallet that pays gas and becomes the contract owner.
DEPLOYER_PRIVATE_KEY=
# Wallet that receives mint proceeds and the 8% perpetual resale royalty.
NFT_TREASURY_ADDRESS=
# Optional: 0 = uncapped supply, 0 = free mint, 800 = 8% royalty.
NFT_MAX_SUPPLY=0
NFT_MINT_PRICE_WEI=0
NFT_ROYALTY_BPS=800
# RPC endpoints (defaults to public endpoints if left blank — fine for
# testing, get your own from Alchemy/Infura for real deploys).
SEPOLIA_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=
MAINNET_RPC_URL=
# Optional: contract verification on the relevant block explorer.
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=
