# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env — it is already gitignored.

# The wallet that signs and pays gas for the deploy transaction. Use a
# dedicated deploy wallet if possible, not your main/cold wallet. Export the
# private key from your wallet app — MetaMask: Account details > Show
# private key. Store this only in this local .env file.
DEPLOYER_PRIVATE_KEY=

# RPC endpoints. The public defaults in hardhat.config.ts work, but a free
# key from https://www.alchemy.com or https://www.infura.io is more reliable.
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Wallet that receives DEFAULT_ADMIN_ROLE and MINTER_ROLE at deployment. This
# is the wallet that will mint Franchise Bundle NFTs after a business is
# certified, and can grant minting rights to other wallets later. Can be the
# same address as the deployer, or a separate wallet you control.
INITIAL_ADMIN_ADDRESS=

# Wallet that receives resale royalty payouts (EIP-2981).
ROYALTY_RECEIVER_ADDRESS=

# Royalty fee in basis points. 500 = 5%. Max 10000 (100%).
ROYALTY_FEE_BPS=500

# Maximum number of Franchise Bundle NFTs that can ever be minted.
MAX_SUPPLY=10000

# Optional: from https://polygonscan.com/myapikey — enables automatic
# source-code verification after deployment.
POLYGONSCAN_API_KEY=
